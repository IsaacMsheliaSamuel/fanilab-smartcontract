STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Secret (S...) key of the deployer account. Locally, import it once as the
# Stellar CLI identity the scripts sign with:
#   stellar keys add deployer --secret-key   # then paste this value
# In CI the same value is supplied via the TESTNET_DEPLOYER_SECRET environment
# secret and imported by the deploy-testnet workflow.
CONTRACT_DEPLOYER_SECRET=S...
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
